# Harness 生产环境变量模板（复制为 .env 后填写，切勿提交真实密钥）
# 生成 SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- 必填 ----------
SECRET_KEY=your-secret-key-here

# ---------- 应用 ----------
HARNESS_VERSION=1.0.0
HARNESS_DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/harness.db
FLASK_ENV=production
DEBUG=false

# ---------- 管理员（首次启动自动创建，生产环境请修改密码）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin123

# ---------- REST API ----------
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ---------- Ollama / 模型（本地或远程推理服务）----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
# DEEPSEEK_API_KEY=your-deepseek-api-key-if-using-cloud-api

# ---------- Nginx / SSL（生产环境）----------
DOMAIN=your-domain.com
SSL_ENABLED=false
# SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# ---------- 可选 PostgreSQL（取消 docker-compose 中 postgres 服务注释后启用）----------
# DATABASE_URL=postgresql+psycopg2://harness:your-db-password@postgres:5432/harness
# POSTGRES_USER=harness
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_DB=harness

# ---------- 可选 Redis ----------
# REDIS_URL=redis://redis:6379/0

# ---------- 健康检查 ----------
HEALTH_URL=http://web:7860/health
